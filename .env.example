# ==============================================================================
# DocuMind Environment Configuration Example
# Copy this file to `.env` and fill in your secrets locally. NEVER commit `.env`.
# ==============================================================================

# --- LLM (Google Gemini API - Free Tier) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Qdrant Vector Database ---
# Modes: memory (tests), docker (local container), cloud (Qdrant Cloud free tier)
QDRANT_MODE=docker
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documind_docs
# Required only when QDRANT_MODE=cloud
QDRANT_URL=
QDRANT_API_KEY=

# --- FastAPI Backend ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Streamlit Frontend ---
STREAMLIT_PORT=7860
API_BASE_URL=http://localhost:8000

# --- MLOps (MLflow) ---
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=documind-rag
